{
  "manifest_version": 3,
  "name": "UnQ Automation — Bulk AI Image & Video Studio",
  "short_name": "UnQ Automation",
  "version": "0.5.0",
  "description": "Queue prompts once and let UnQ generate, rename, and download images and videos in bulk across Meta AI, Google Flow, Grok, Gemini, ChatGPT, and Qwen.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "sidePanel",
    "tabs",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.meta.ai/*",
    "https://labs.google/*",
    "https://grok.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.qwen.ai/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "UnQ Automation"
  },
  "side_panel": {
    "default_path": "dist/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.meta.ai/*",
        "https://labs.google/*",
        "https://grok.com/*",
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/adapters/*.js", "src/core/*.js", "src/registry.js"],
      "matches": [
        "https://*.meta.ai/*",
        "https://labs.google/*",
        "https://grok.com/*",
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.qwen.ai/*"
      ]
    }
  ]
}
