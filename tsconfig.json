{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["chrome"]
	},
	"include": ["ui", "src"]
}
